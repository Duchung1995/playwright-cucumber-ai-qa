{
  "name": "toolshop-qa-bdd",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript + Cucumber BDD framework POC for the Toolshop demo app, with a Claude Code agentic QA harness",
  "type": "commonjs",
  "scripts": {
    "test": "cucumber-js",
    "test:api": "cucumber-js --profile api",
    "test:ui": "cucumber-js --profile ui",
    "test:smoke": "cucumber-js --profile smoke",
    "test:tag": "cucumber-js --tags",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "steps:list": "tsx .claude/skills/write-gherkin/scripts/list-steps.ts",
    "report:parse": "tsx .claude/skills/parse-cucumber-report/scripts/parse-report.ts",
    "trace:show": "playwright show-trace",
    "report:failures": "tsx .claude/skills/parse-cucumber-report/scripts/parse-report.ts --markdown"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "^22 || ^24 || >=26"
  }
}
